[gd_resource type="Resource" script_class="MomStoryArc" load_steps=5 format=3]

[ext_resource type="Script" path="res://Scripts/Data/story_arc.gd" id="1_arc"]
[ext_resource type="Script" path="res://Scripts/Data/story_beat.gd" id="2_beat"]

[sub_resource type="Resource" id="beat_0"]
script = ExtResource("2_beat")
beat_index = 0
dialog_node_id = "story_squirrel_first_sighting"
min_channel = 10
sets_flag = "squirrel_campaign_started"

[sub_resource type="Resource" id="beat_1"]
script = ExtResource("2_beat")
beat_index = 1
dialog_node_id = "story_squirrel_countermove"
min_channel = 14
requires_flag = "squirrel_campaign_started"
sets_flag = "squirrel_countermove_seen"

[sub_resource type="Resource" id="beat_2"]
script = ExtResource("2_beat")
beat_index = 2
dialog_node_id = "story_squirrel_payoff"
min_channel = 18
requires_flag = "squirrel_countermove_seen"
reward_money = 30
reward_mood = -1
reward_rep = 1

[resource]
script = ExtResource("1_arc")
id = "squirrel_campaign"
character_id = "mom"
display_name = "The Squirrel Campaign"
priority = 2
beats = Array[ExtResource("2_beat")]([SubResource("beat_0"), SubResource("beat_1"), SubResource("beat_2")])