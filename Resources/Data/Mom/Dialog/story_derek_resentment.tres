[gd_resource type="Resource" script_class="MomDialogNode" load_steps=11 format=3]

[ext_resource type="Script" uid="uid://fb034uin8iio" path="res://Scripts/Data/mom_dialog_node.gd" id="1_node"]
[ext_resource type="Script" uid="uid://dxwgr1c0fc1bj" path="res://Scripts/Data/mom_dialog_response.gd" id="2_resp"]
[ext_resource type="Script" uid="uid://d0h8ia570dbbb" path="res://Scripts/Data/mom_dialog_outcome.gd" id="3_out"]

[sub_resource type="Resource" id="out_polite_1"]
script = ExtResource("3_out")
weight = 6.0
effect = "mood_delta"
mood_delta = 1
result_text = "[color=orange]I don't WANT to hear about Derek either.[/color] And yet here we both are."
result_expression = "upset"

[sub_resource type="Resource" id="out_polite_2"]
script = ExtResource("3_out")
weight = 4.0
result_text = "...You're right. I'm sorry, baby. Aunt Linda just gets in my head sometimes."

[sub_resource type="Resource" id="resp_polite"]
script = ExtResource("2_resp")
button_text = "Please stop comparing us."
tone = "polite"
outcomes = Array[ExtResource("3_out")]([SubResource("out_polite_1"), SubResource("out_polite_2")])

[sub_resource type="Resource" id="out_neutral_1"]
script = ExtResource("3_out")
weight = 6.0
effect = "grudge_delta"
grudge_delta = 1
result_text = "[color=orange]Derek's mother never has to call the mall. NEVER.[/color] Think about why that is."
result_expression = "upset"

[sub_resource type="Resource" id="out_neutral_2"]
script = ExtResource("3_out")
weight = 4.0
effect = "mood_delta"
mood_delta = 1
result_text = "Aunt Linda GLOWS about him. Glows! Do you know what that's like at church picnics?"
result_expression = "upset"

[sub_resource type="Resource" id="resp_neutral"]
script = ExtResource("2_resp")
button_text = "I'm not Derek, Mom."
tone = "neutral"
outcomes = Array[ExtResource("3_out")]([SubResource("out_neutral_1"), SubResource("out_neutral_2")])

[sub_resource type="Resource" id="out_sassy_1"]
script = ExtResource("3_out")
weight = 5.0
effect = "apply_tier"
magnitude = 2
mood_delta = 1
result_text = "[color=red][shake rate=20 level=10]EXCUSE me?![/shake][/color] Derek would NEVER - oh who am I kidding, you're BOTH impossible!"
result_expression = "upset"

[sub_resource type="Resource" id="out_sassy_2"]
script = ExtResource("3_out")
weight = 3.0
effect = "mood_delta"
mood_delta = 2
result_text = "[color=orange]One more word about Derek and you'll be doing HIS chores too.[/color]"
result_expression = "upset"

[sub_resource type="Resource" id="out_sassy_3"]
script = ExtResource("3_out")
weight = 2.0
effect = "storms_off"
mood_delta = 2
grudge_delta = 1
followup_node_id = "sass_storm_off"

[sub_resource type="Resource" id="resp_sassy"]
script = ExtResource("2_resp")
button_text = "Derek sucks and you know it."
tone = "sassy"
outcomes = Array[ExtResource("3_out")]([SubResource("out_sassy_1"), SubResource("out_sassy_2"), SubResource("out_sassy_3")])

[resource]
script = ExtResource("1_node")
id = "story_derek_resentment"
mom_text = "You know what Aunt Linda said at the picnic? 'Derek mowed the WHOLE lawn without being asked.' Without being ASKED. Meanwhile I have to come down HERE."
expression = "upset"
responses = Array[ExtResource("2_resp")]([SubResource("resp_polite"), SubResource("resp_neutral"), SubResource("resp_sassy")])
