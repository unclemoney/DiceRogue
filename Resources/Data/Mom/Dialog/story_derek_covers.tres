[resource]
script = ExtResource("1_node")
id = "story_derek_covers"
mom_text = "You'll never believe it. When I asked about Tuesday, DEREK - of all people - said you were with HIM. Studying. The golden child covered for you, sweetie."
expression = "neutral"
speaker_name = "Mom"
speaker_tint = Color(1, 1, 1, 1)
