[sub_resource type="Resource" id="out_polite_1"]
script = ExtResource("3_out")
weight = 6.0
effect = "reward_consumable"
mood_delta = -1
result_text = "[color=green]Attaboy.[/color] Here - champion's snack. Don't spend it all on one reroll."
result_expression = "happy"

[sub_resource type="Resource" id="out_polite_2"]
script = ExtResource("3_out")
weight = 4.0
effect = "mood_delta"
mood_delta = -1
result_text = "Smart kid. The bank-it-early rule has saved more runs than luck ever did."
result_expression = "happy"

[sub_resource type="Resource" id="resp_polite"]
script = ExtResource("2_resp")
button_text = "Noted. Bank the full house."
tone = "polite"
outcomes = Array[ExtResource("3_out")]([SubResource("out_polite_1"), SubResource("out_polite_2")])

[sub_resource type="Resource" id="out_neutral_1"]
script = ExtResource("3_out")
weight = 6.0
effect = "reward_consumable"
result_text = "Multitudes, yes. Here - for the road. Mom's treat."

[sub_resource type="Resource" id="out_neutral_2"]
script = ExtResource("3_out")
weight = 4.0
effect = "mood_delta"
mood_delta = -1
result_text = "Thirty years of math homework and casseroles, sweetie. The dice stayed in my blood."
result_expression = "happy"

[sub_resource type="Resource" id="resp_neutral"]
script = ExtResource("2_resp")
button_text = "You contain multitudes?"
tone = "neutral"
outcomes = Array[ExtResource("3_out")]([SubResource("out_neutral_1"), SubResource("out_neutral_2")])

[sub_resource type="Resource" id="out_sassy_1"]
script = ExtResource("3_out")
weight = 6.0
effect = "mood_delta"
mood_delta = -1
result_text = "[color=green]HA! There's my champion.[/color] Fine - learn it the hard way, like I did."
result_expression = "happy"

[sub_resource type="Resource" id="out_sassy_2"]
script = ExtResource("3_out")
weight = 4.0
effect = "mood_delta"
mood_delta = 1
result_text = "[color=orange]Ignore the champ's advice then. The trophy will comfort ME tonight.[/color]"
result_expression = "upset"

[sub_resource type="Resource" id="resp_sassy"]
script = ExtResource("2_resp")
button_text = "I chase inside straights."
tone = "sassy"
outcomes = Array[ExtResource("3_out")]([SubResource("out_sassy_1"), SubResource("out_sassy_2")])

[resource]
script = ExtResource("1_node")
id = "story_mom_tips"
mom_text = "Alright, leaning in - don't tell your father. Never chase the inside straight on the last roll. And always bank the full house early. ...What? I contain multitudes."
expression = "happy"
responses = Array[ExtResource("2_resp")]([SubResource("resp_polite"), SubResource("resp_neutral"), SubResource("resp_sassy")])
