[sub_resource type="Resource" id="out_polite_1"]
script = ExtResource("3_out")
weight = 7.0
effect = "mood_delta"
mood_delta = -1
result_text = "[color=green]I'm sure you were.[/color] Just remember: she sees everything, so BE everything-good."
result_expression = "happy"

[sub_resource type="Resource" id="out_polite_2"]
script = ExtResource("3_out")
weight = 3.0
result_text = "Mm-hm. 'Just playing.' I've heard that before, mister."

[sub_resource type="Resource" id="resp_polite"]
script = ExtResource("2_resp")
button_text = "I was just playing, Mom."
tone = "polite"
outcomes = Array[ExtResource("3_out")]([SubResource("out_polite_1"), SubResource("out_polite_2")])

[sub_resource type="Resource" id="out_neutral_1"]
script = ExtResource("3_out")
weight = 6.0
result_text = "Oh yes. Bingo night is basically a surveillance briefing. Behave."

[sub_resource type="Resource" id="out_neutral_2"]
script = ExtResource("3_out")
weight = 4.0
effect = "mood_delta"
mood_delta = 1
result_text = "[color=orange]Don't look so nervous - it makes you look guilty.[/color]"
result_expression = "upset"

[sub_resource type="Resource" id="resp_neutral"]
script = ExtResource("2_resp")
button_text = "She WATCHES me?!"
tone = "neutral"
outcomes = Array[ExtResource("3_out")]([SubResource("out_neutral_1"), SubResource("out_neutral_2")])

[sub_resource type="Resource" id="out_sassy_1"]
script = ExtResource("3_out")
weight = 5.0
effect = "mood_delta"
mood_delta = 1
result_text = "[color=orange]That 'hobby' raised this neighborhood, young one.[/color] Respect your elders."
result_expression = "upset"

[sub_resource type="Resource" id="out_sassy_2"]
script = ExtResource("3_out")
weight = 3.0
effect = "apply_tier"
magnitude = 2
result_text = "[color=red][shake rate=20 level=10]EXCUSE me?![/shake][/color] Mrs. Patterson is a SAINT and you are GROUNDED-adjacent!"
result_expression = "upset"

[sub_resource type="Resource" id="out_sassy_3"]
script = ExtResource("3_out")
weight = 2.0
effect = "storms_off"
mood_delta = 2
grudge_delta = 1
followup_node_id = "sass_storm_off"

[sub_resource type="Resource" id="resp_sassy"]
script = ExtResource("2_resp")
button_text = "She needs a hobby."
tone = "sassy"
outcomes = Array[ExtResource("3_out")]([SubResource("out_sassy_1"), SubResource("out_sassy_2"), SubResource("out_sassy_3")])

[resource]
script = ExtResource("1_node")
id = "story_patterson_intro"
mom_text = "Mrs. Patterson plays bingo near the Food Court, you know. She sees EVERYTHING. She told me she saw you at the {zone} the other day - said you looked 'up to something.'"
expression = "neutral"
responses = Array[ExtResource("2_resp")]([SubResource("resp_polite"), SubResource("resp_neutral"), SubResource("resp_sassy")])
