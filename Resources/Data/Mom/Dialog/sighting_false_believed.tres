[gd_resource type="Resource" script_class="MomDialogNode" load_steps=13 format=3]

[ext_resource type="Script" uid="uid://fb034uin8iio" path="res://Scripts/Data/mom_dialog_node.gd" id="1_node"]
[ext_resource type="Script" uid="uid://dxwgr1c0fc1bj" path="res://Scripts/Data/mom_dialog_response.gd" id="2_resp"]
[ext_resource type="Script" uid="uid://d0h8ia570dbbb" path="res://Scripts/Data/mom_dialog_outcome.gd" id="3_out"]

[sub_resource type="Resource" id="out_admit_1"]
script = ExtResource("3_out")
weight = 6.0
result_text = "At least you admit it. That doesn't make it okay, but it's something."

[sub_resource type="Resource" id="out_admit_2"]
script = ExtResource("3_out")
weight = 4.0
effect = "mood_delta"
mood_delta = -1
result_text = "Honesty. Good. Keep that up and maybe I stop taking her calls."
result_expression = "happy"

[sub_resource type="Resource" id="resp_admit"]
script = ExtResource("2_resp")
button_text = "Okay, you got me."
tone = "polite"
outcomes = Array[ExtResource("3_out")]([SubResource("out_admit_1"), SubResource("out_admit_2")])

[sub_resource type="Resource" id="out_silent_1"]
script = ExtResource("3_out")
weight = 6.0
effect = "grudge_delta"
grudge_delta = 1
result_text = "[color=orange]Nothing to say? That's an answer too.[/color]"
result_expression = "upset"

[sub_resource type="Resource" id="out_silent_2"]
script = ExtResource("3_out")
weight = 4.0
result_text = "...Fine. Keep your secrets."

[sub_resource type="Resource" id="resp_silent"]
script = ExtResource("2_resp")
button_text = "(say nothing)"
tone = "neutral"
outcomes = Array[ExtResource("3_out")]([SubResource("out_silent_1"), SubResource("out_silent_2")])

[sub_resource type="Resource" id="out_contest_fail"]
script = ExtResource("3_out")
weight = 65.0
effect = "grudge_delta"
mood_delta = 1
grudge_delta = 1
followup_node_id = "patterson_contest_failed"

[sub_resource type="Resource" id="out_contest_win"]
script = ExtResource("3_out")
weight = 35.0
effect = "mood_delta"
mood_delta = -1
followup_node_id = "flag_patterson_doubted"

[sub_resource type="Resource" id="resp_contest"]
script = ExtResource("2_resp")
button_text = "That's a lie - I was never there!"
tone = "neutral"
outcomes = Array[ExtResource("3_out")]([SubResource("out_contest_fail"), SubResource("out_contest_win")])

[sub_resource type="Resource" id="out_sassy_1"]
script = ExtResource("3_out")
weight = 5.0
effect = "apply_tier"
magnitude = 2
mood_delta = 1
result_text = "[color=red][shake rate=20 level=10]EXCUSE me?![/shake][/color] That mouth just earned you a punishment!"
result_expression = "upset"

[sub_resource type="Resource" id="out_sassy_2"]
script = ExtResource("3_out")
weight = 3.0
effect = "mood_delta"
mood_delta = 2
result_text = "[color=orange]Watch that tone.[/color] We're not done here."
result_expression = "upset"

[sub_resource type="Resource" id="out_sassy_3"]
script = ExtResource("3_out")
weight = 2.0
effect = "storms_off"
mood_delta = 2
grudge_delta = 1
followup_node_id = "sass_storm_off"

[sub_resource type="Resource" id="resp_sassy"]
script = ExtResource("2_resp")
button_text = "Patterson's a spy and you know it!"
tone = "sassy"
outcomes = Array[ExtResource("3_out")]([SubResource("out_sassy_1"), SubResource("out_sassy_2"), SubResource("out_sassy_3")])

[resource]
script = ExtResource("1_node")
id = "sighting_false_believed"
mom_text = "Mrs. Patterson saw you at the {zone}. Do NOT lie to me - she described your JACKET."
expression = "upset"
responses = Array[ExtResource("2_resp")]([SubResource("resp_admit"), SubResource("resp_silent"), SubResource("resp_contest"), SubResource("resp_sassy")])
