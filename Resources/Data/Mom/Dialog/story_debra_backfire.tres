[resource]
script = ExtResource("1_node")
id = "story_debra_backfire"
mom_text = "Oh, sweetie, it's DELICIOUS. Debra tried to gossip about ME at the neighborhood watch meeting - and the whole room turned on HER. [color=green]I'm framing the minutes.[/color]"
expression = "happy"
speaker_name = "Mom"
speaker_tint = Color(1, 1, 1, 1)
