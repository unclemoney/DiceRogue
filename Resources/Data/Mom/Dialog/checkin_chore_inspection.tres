[resource]
script = ExtResource("1_node")
id = "checkin_chore_inspection"
mom_text = "Don't mind me - Mom's just doing a little white-glove inspection of your room. Hm. Interesting choices have been made under this bed."
expression = "neutral"
speaker_name = "Mom"
speaker_tint = Color(1, 1, 1, 1)
responses = Array[ExtResource("2_resp")]([SubResource("resp_polite"), SubResource("resp_neutral"), SubResource("resp_sassy")])
