weight = 6.0
effect = "none"
magnitude = 0
mood_delta = 0
grudge_delta = 0
permanent = false
followup_node_id = ""
result_text = "'Not that bad' is how hoarding starts, sweetie. I've seen the documentaries. All of them."
result_expression = "neutral"
ends_visit = true

[sub_resource type="Resource" id="out_neutral_2"]
