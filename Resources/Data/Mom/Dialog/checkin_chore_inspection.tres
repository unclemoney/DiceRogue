magnitude = 0
mood_delta = 1
grudge_delta = 0
permanent = false
followup_node_id = ""
result_text = "[color=orange]Not that BAD?[/color] I found a glass from March. It has rings. Geologists could date it."
result_expression = "upset"
ends_visit = true

[sub_resource type="Resource" id="resp_neutral"]
