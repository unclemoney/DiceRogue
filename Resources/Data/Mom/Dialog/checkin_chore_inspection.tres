weight = 3.0
effect = "none"
magnitude = 0
mood_delta = -1
grudge_delta = 0
permanent = false
followup_node_id = ""
result_text = "Mm, mostly passable. The sock under the lamp gets a warning. This time."
result_expression = "neutral"
ends_visit = true

[sub_resource type="Resource" id="resp_polite"]
