[gd_resource type="Resource" script_class="MomDialogNode" load_steps=11 format=3]

[ext_resource type="Script" uid="uid://fb034uin8iio" path="res://Scripts/Data/mom_dialog_node.gd" id="1_node"]
[ext_resource type="Script" uid="uid://dxwgr1c0fc1bj" path="res://Scripts/Data/mom_dialog_response.gd" id="2_resp"]
[ext_resource type="Script" uid="uid://d0h8ia570dbbb" path="res://Scripts/Data/mom_dialog_outcome.gd" id="3_out"]

[sub_resource type="Resource" id="out_polite_1"]
script = ExtResource("3_out")
weight = 7.0
effect = "apply_tier"
magnitude = -1
result_text = "Sorry won't cut it this time. [color=red]Your father says no allowance excuses.[/color]"
result_expression = "upset"

[sub_resource type="Resource" id="out_polite_2"]
script = ExtResource("3_out")
weight = 3.0
effect = "apply_tier"
magnitude = 0
result_text = "...Hold on. He's asking if you're sorry. I'll tell him yes. This ONCE."
result_expression = "neutral"

[sub_resource type="Resource" id="resp_polite"]
script = ExtResource("2_resp")
button_text = "I'm sorry! Really!"
tone = "polite"
outcomes = Array[ExtResource("3_out")]([SubResource("out_polite_1"), SubResource("out_polite_2")])

[sub_resource type="Resource" id="out_neutral_1"]
script = ExtResource("3_out")
weight = 8.0
effect = "apply_tier"
magnitude = -1
result_text = "Nothing to say? Your father says 'typical.' I defended you. Don't make me regret it."
result_expression = "upset"

[sub_resource type="Resource" id="out_neutral_2"]
script = ExtResource("3_out")
weight = 2.0
effect = "apply_tier"
magnitude = 0
result_text = "...He's laughing at something. That's either very good or very bad for you."
result_expression = "neutral"

[sub_resource type="Resource" id="resp_neutral"]
script = ExtResource("2_resp")
button_text = "(stare at the floor)"
tone = "neutral"
outcomes = Array[ExtResource("3_out")]([SubResource("out_neutral_1"), SubResource("out_neutral_2")])

[sub_resource type="Resource" id="out_sassy_1"]
script = ExtResource("3_out")
weight = 9.0
effect = "apply_tier"
magnitude = -1
grudge_delta = 1
result_text = "[color=red][shake rate=20 level=10]He heard that.[/shake][/color] He HEARD that. You're on your own, kid."
result_expression = "upset"

[sub_resource type="Resource" id="out_sassy_2"]
script = ExtResource("3_out")
weight = 1.0
effect = "storms_off"
mood_delta = 2
grudge_delta = 1
followup_node_id = "sass_storm_off"

[sub_resource type="Resource" id="resp_sassy"]
script = ExtResource("2_resp")
button_text = "Tell him I said hi."
tone = "sassy"
outcomes = Array[ExtResource("3_out")]([SubResource("out_sassy_1"), SubResource("out_sassy_2")])

[resource]
script = ExtResource("1_node")
id = "story_dad_call"
mom_text = "Yes. YES, I see it too. ...Mm-hm. The WHOLE mall. [color=red]Your father says you're in for it now.[/color]"
expression = "upset"
speaker_name = "Mom (on the phone with Dad)"
speaker_tint = Color(0.45, 0.5, 0.65, 1)
responses = Array[ExtResource("2_resp")]([SubResource("resp_polite"), SubResource("resp_neutral"), SubResource("resp_sassy")])
