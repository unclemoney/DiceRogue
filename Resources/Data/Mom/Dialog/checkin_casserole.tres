[resource]
script = ExtResource("1_node")
id = "checkin_casserole"
mom_text = "Sweetie, sit. Mom tried a new recipe - tuna casserole surprise. The surprise is pears. I want your HONEST opinion. Completely honest. No consequences either way."
expression = "happy"
speaker_name = "Mom"
speaker_tint = Color(1, 1, 1, 1)
responses = Array[ExtResource("2_resp")]([SubResource("resp_polite"), SubResource("resp_neutral"), SubResource("resp_sassy")])
