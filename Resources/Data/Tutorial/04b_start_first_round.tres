[gd_resource type="Resource" script_class="TutorialStep" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Core/tutorial_step.gd" id="1"]

[resource]
script = ExtResource("1")
id = "start_first_round"
title = "Open the First Store"
message = "Click [color=#FFD952]NEXT ROUND[/color], then use the round panel's [color=#FFD952]Let's Play[/color] button. The store deals your dice and makes the opening roll."
mom_expression = "happy"
highlight_node_path = "GameUI/MarginContainer/MainVBox/MiddleSection/LeftColumn/GameButtonContainer/ContentVBox/GameButtonUI/HBoxContainer/RightButtonArea/NextRoundButton"
show_click_indicator = true
required_action = "click_next_round"
next_step_id = "chore_select"
category = "game_loop"
dialog_position = "right"
show_backdrop = false
