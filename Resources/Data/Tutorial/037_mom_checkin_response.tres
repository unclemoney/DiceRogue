[resource]
script = ExtResource("1")
id = "mom_checkin_response"
title = "Answer Mom"
message = "Responses have polite, neutral, or sassy tones and weighted outcomes. Choose any response. In this safe example, polite or neutral can earn Teacher's Pet; successful sass earns Rebellion and REP."
