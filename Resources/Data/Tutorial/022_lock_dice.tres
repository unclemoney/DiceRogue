[gd_resource type="Resource" script_class="TutorialStep" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Core/tutorial_step.gd" id="1"]

[resource]
script = ExtResource("1")
id = "lock_dice"
title = "Keep the Good Dice"
message = "Click a die to [color=#FFD952]lock[/color] it. Locked dice keep their value on later rolls; click again to unlock. Lock one die now."
mom_expression = "happy"
highlight_node_path = "GameUI/MarginContainer/MainVBox/MiddleSection/CenterColumn/DiceAreaContainer"
show_click_indicator = true
required_action = "lock_die"
next_step_id = "roll_again"
category = "game_loop"
dialog_position = "top"
show_backdrop = false
