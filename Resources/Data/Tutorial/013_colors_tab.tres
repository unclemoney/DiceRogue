semantic_target = "shop_tab:colors"
action_payload = {"tab_index": 3}
show_click_indicator = true
required_action = "shop_tab_changed"
next_step_id = "debuffs_intro"
category = "colors"
dialog_position = "bottom"
show_backdrop = false
