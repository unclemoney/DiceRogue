[ext_resource type="Script" path="res://Scripts/Core/tutorial_step.gd" id="1"]

[resource]
script = ExtResource("1")
id = "colors_tab"
title = "Open the Color Shelf"
message = "Click the [color=#FFD952]COLORS[/color] tab. Buying a color lets it appear on rolled dice; it does not add another die."
