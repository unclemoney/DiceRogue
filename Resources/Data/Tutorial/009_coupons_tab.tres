[gd_resource type="Resource" script_class="TutorialStep" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Core/tutorial_step.gd" id="1"]

[resource]
script = ExtResource("1")
id = "coupons_tab"
title = "Open the Coupon Shelf"
message = "Click the [color=#FFD952]COUPONS[/color] tab. Coupons are single-use items with their own timing rules and four inventory slots."
